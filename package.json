{
  "displayName": "laundrify (Official)",
  "name": "homebridge-laundrify-official",
  "version": "1.5.0",
  "description": "Expose your laundrify Power Plugs to Apple HomeKit using Homebridge.",
  "license": "Apache-2.0",
  "homepage": "https://laundrify.de",
  "repository": {
    "type": "git",
    "url": "git://github.com/laundrify/homebridge-laundrify-official.git"
  },
  "bugs": {
    "url": "https://github.com/laundrify/homebridge-laundrify-official/issues"
  },
  "engines": {
    "homebridge": "^1.6.0 || ^2.0.0",
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "mock": "ts-node -P tsconfig.test.json test/mock-backend/cli.ts",
    "dev": "npm run build && homebridge -D -U ./test/hbConfig -P ..",
    "watch": "nodemon",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "homebridge",
    "homebridge-plugin",
    "laundrify",
    "laundrify-official"
  ],
  "dependencies": {
    "axios": "^1.18.1",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "@homebridge/hap-nodejs": "2.2.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^9.39.0",
    "homebridge": "^2.0.0",
    "nodemon": "^3.1.7",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.1"
  }
}
